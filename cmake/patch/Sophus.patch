--- SophusConfig.cmake.in	2026-05-14 12:11:06.725225770 -0500
+++ SophusConfig.cmake.in.new	2026-05-15 14:52:49.470365920 -0500
@@ -1,8 +1,36 @@
 @PACKAGE_INIT@

 include (CMakeFindDependencyMacro)
+include(FetchContent)
+FetchContent_GetProperties(sophus)
+
+# ---------------------------------------------------------------
+# FetchContent / add_subdirectory mode
+# ---------------------------------------------------------------
+if(TARGET sophus)
+    if(NOT TARGET sophus::sophus)
+        add_library(sophus::sophus INTERFACE IMPORTED GLOBAL)
+        set_target_properties(sophus::sophus PROPERTIES
+            INTERFACE_LINK_LIBRARIES "$<BUILD_INTERFACE:sophus>"
+            INTERFACE_INCLUDE_DIRECTORIES "@CMAKE_CURRENT_LIST_DIR@"
+        )
+    endif()
+    set(Sophus_FOUND TRUE CACHE BOOL "" FORCE)
+    return()
+endif()

 @Eigen3_DEPENDENCY@
 @fmt_DEPENDENCY@

-include ("${CMAKE_CURRENT_LIST_DIR}/SophusTargets.cmake")
+# ---------------------------------------------------------------
+# Installed-package mode
+# ---------------------------------------------------------------
+set(_sophus_targets "${CMAKE_CURRENT_LIST_DIR}/SophusTargets.cmake")
+if(NOT EXISTS "${_sophus_targets}")
+    set(Sophus_FOUND FALSE CACHE BOOL "" FORCE)
+    unset(_sophus_targets)
+    return()
+endif()
+
+include("${_sophus_targets}")
+unset(_sophus_targets)
